CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# PostgreSQL is the only application database. Docker overrides the host to db-postgres.
POSTGRES_USER=echoring
POSTGRES_PASSWORD=
POSTGRES_DB=api5_relacional
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public
# Optional alternative to the POSTGRES_* variables above (never commit credentials).
DATABASE_URL=

# Compatibilidade com o contêiner legado. A API não persiste dados no MongoDB.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=

# General administrator. This account can create platform users.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador Geral

# Translator access. Set a unique password of at least 12 characters.
TRANSLATOR_EMAIL=
TRANSLATOR_PASSWORD=
TRANSLATOR_NAME=Tradutor Aliança

# Existing private staff access. Both profiles use the role-aware auth endpoint.
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_NAME=Equipe Aliança
# Real quote delivery. Credentials stay only on the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Development only: skip SMTP and approve a quote immediately when staff sends it.
AUTO_APPROVE_QUOTES=false

# Public web URL used in the approve/decline links sent to clients.
FRONTEND_PUBLIC_URL=http://localhost:8081
# Number of days a quote response link remains valid (1-365).
QUOTE_RESPONSE_DAYS=30
