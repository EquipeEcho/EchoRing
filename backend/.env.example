CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Local database addresses, reserved for the persistence implementation.
DATABASE_URL=postgresql://admin:admin@localhost:5432/api5_relacional
MONGODB_URL=mongodb://admin:admin@localhost:27017/?authSource=admin

# General administrator. This account can create platform users.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador Geral

# Translator access. Set a unique password of at least 12 characters.
TRANSLATOR_EMAIL=
TRANSLATOR_PASSWORD=
TRANSLATOR_NAME=Tradutor Aliança

# Existing private staff access. Both profiles use the role-aware auth endpoint.
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_NAME=Equipe Aliança
# Intake persistence (SQLite, independent from the reserved databases above).
REQUESTS_DB_PATH=.local/requests.sqlite3
# Real quote delivery. Credentials stay only on the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
